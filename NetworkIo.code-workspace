{
	"folders": [
		{
			"path": ".",
			"name": "NetworkIo (Root)"
		},
		{
			"path": "server",
			"name": "Server (Ktor)"
		},
		{
			"path": "shared",
			"name": "Shared (KMP)"
		},
		{
			"path": "composeApp",
			"name": "ComposeApp (Client)"
		}
	],
	"settings": {
		"files.exclude": {
			"**/build": true,
			"**/.gradle": true,
			"**/.idea": true,
			"**/node_modules": true
		},
		"kotlin.languageServer.enabled": true,
		"gradle.nestedProjects": true
	},
	"extensions": {
		"recommendations": [
			"mathiasfrohlich.kotlin",
			"fwcd.kotlin",
			"vscjava.vscode-gradle",
			"redhat.vscode-yaml"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"type": "kotlin",
				"request": "launch",
				"name": "Run Server",
				"projectRoot": "${workspaceFolder}/server",
				"mainClass": "com.example.networkio.ApplicationKt"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Run Server",
				"type": "shell",
				"command": "./gradlew :server:run",
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": false
				}
			},
			{
				"label": "Run ComposeApp",
				"type": "shell",
				"command": "./gradlew :composeApp:run",
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": false
				}
			},
			{
				"label": "Build All",
				"type": "shell",
				"command": "./gradlew build -x test",
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "Clean Build",
				"type": "shell",
				"command": "./gradlew clean build -x test",
				"problemMatcher": []
			}
		]
	}
}
